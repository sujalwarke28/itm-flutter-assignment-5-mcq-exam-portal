# Server
# NOTE: 5000 conflicts with macOS AirPlay Receiver (ControlCenter) on many Macs — 5050 avoids that.
PORT=5050
NODE_ENV=development

# JWT (used only if you add any custom token signing beyond Firebase ID tokens)
JWT_SECRET=replace_with_a_long_random_string

# Firebase Admin SDK
# Generate from Firebase Console > Project Settings > Service Accounts > Generate new private key
# Paste the downloaded JSON contents as a single-line string here, OR set
# FIREBASE_SERVICE_ACCOUNT_PATH to point at a local json file (gitignored).
FIREBASE_SERVICE_ACCOUNT_PATH=./src/config/serviceAccountKey.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UNSIGNED_UPLOAD_PRESET=mcq_portal_unsigned
